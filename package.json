{
  "name": "spectra-lib",
  "version": "0.29.3",
  "private": true,
  "description": "Aviv's personal shared library -- reusable components/tokens/utilities that span more than one project. Currently: GateOpen's design tokens, a cn() helper, a findUp() build-config utility, cv/portfolio's shared chrome.css/dom.js, a Radix-based dashboard UI component set shared by GateOpen/bagStore/SpectraHub/Raptor2, a GSAP scroll-reveal module (React + vanilla) shared by eliyaWebsite/spectra-website/portfolio-family sites, a tech/brand icon set (React + vanilla) shared by spectra-website and cv, the spectra-ui UI-catalog scanner/CLI (Spectra Design Bridge, 2026-08-28), React Native status components (StatusScreen/StatusBanner) shared by native apps, and a React Native push-notification interface (permissions/registration/channels/foreground/background/local/deep-link) built on expo-notifications.",
  "type": "module",
  "main": "dist/tokens.js",
  "types": "dist/tokens.d.ts",
  "bin": {
    "spectra-ui": "./bin/spectra-ui.mjs"
  },
  "exports": {
    "./ui-catalog": {
      "types": "./dist/ui-catalog.d.ts",
      "default": "./dist/ui-catalog.js"
    },
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "default": "./dist/cn.js"
    },
    "./node-utils": {
      "types": "./dist/node-utils.d.ts",
      "default": "./dist/node-utils.js"
    },
    "./boot-splash": {
      "types": "./dist/boot-splash.d.ts",
      "default": "./dist/boot-splash.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./reveal": {
      "types": "./dist/reveal.d.ts",
      "default": "./dist/reveal.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./native/push": {
      "types": "./dist/native/push/index.d.ts",
      "default": "./dist/native/push/index.js"
    },
    "./native/push/background": {
      "types": "./dist/native/push/background.d.ts",
      "default": "./dist/native/push/background.js"
    },
    "./styles/theme.css": "./styles/theme.css",
    "./styles/chrome.css": "./styles/chrome.css"
  },
  "files": [
    "dist",
    "bin",
    "chrome",
    "styles",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo-constants": ">=18.0.0",
    "expo-notifications": ">=0.32.0",
    "expo-task-manager": ">=14.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": ">=0.73",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "expo-task-manager": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-notifications": "^0.32.17",
    "expo-task-manager": "~14.0.9",
    "gsap": "^3.13.0",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.6",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.3",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
